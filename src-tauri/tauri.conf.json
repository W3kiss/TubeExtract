{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TubeExtract",
  "version": "0.1.0",
  "identifier": "com.tubeextract.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "TubeExtract",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "backgroundColor": "#030304"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Video & audio downloader",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
